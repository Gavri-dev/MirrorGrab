<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Color palette matching the Python app -->
  <Color x:Key="Bg">#1a1a1a</Color>
  <Color x:Key="BgAlt">#232323</Color>
  <Color x:Key="BgPanel">#2a2a2a</Color>
  <Color x:Key="BgHover">#333333</Color>
  <Color x:Key="BgSelected">#2d4f7a</Color>
  <Color x:Key="BorderColor">#383838</Color>
  <Color x:Key="TextColor">#e4e4e4</Color>
  <Color x:Key="TextDim">#8a8a8a</Color>
  <Color x:Key="TextMuted">#6a6a6a</Color>
  <Color x:Key="Accent">#4a9eff</Color>
  <Color x:Key="AccentHover">#5fadff</Color>
  <Color x:Key="AccentPressed">#3d8ce6</Color>
  <Color x:Key="Success">#5bbd5b</Color>
  <Color x:Key="Warning">#e8b84a</Color>
  <Color x:Key="Error">#e05858</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}" />
  <SolidColorBrush x:Key="BgAltBrush" Color="{StaticResource BgAlt}" />
  <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanel}" />
  <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}" />
  <SolidColorBrush x:Key="BgSelectedBrush" Color="{StaticResource BgSelected}" />

  <!-- Icon geometries (Material Design Icons, 24x24 viewBox) -->
