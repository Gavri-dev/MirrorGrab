<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>MirrorGrab</AssemblyName>
    <RootNamespace>MirrorGrab</RootNamespace>
    <Version>1.0.0</Version>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="SharpCompress" Version="0.38.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Themes\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-order only: make sure the headless-WebView2 resolver is built before we copy it. -->
    <ProjectReference Include="..\FfResolver\FfResolver.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <!-- Drop FfResolver.exe (+ its files) into resolver\ beside MirrorGrab.exe, on build and publish. -->
  <Target Name="CopyFfResolver" AfterTargets="Build">
    <ItemGroup>
      <_FfResolverFiles Include="$(MSBuildThisFileDirectory)..\FfResolver\bin\$(Configuration)\net8.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FfResolverFiles)"
          DestinationFiles="@(_FfResolverFiles->'$(OutDir)resolver\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyFfResolverOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <_FfResolverPub Include="$(MSBuildThisFileDirectory)..\FfResolver\bin\$(Configuration)\net8.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_FfResolverPub)"
          DestinationFiles="@(_FfResolverPub->'$(PublishDir)resolver\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
